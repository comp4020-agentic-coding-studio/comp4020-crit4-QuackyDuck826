---
import Layout from "../layouts/Layout.astro";
import "../styles/instrument.css";
import { CHARACTERS } from "../scripts/characters";
---

<Layout
  title="Loopwright — a click-together instrument"
  description="Eight tappable shapes, one shared scale and tempo: toggle any combination and the loops lock together, so nothing you play can clash."
>
  <header>
    <nav aria-label="Primary"></nav>
  </header>
  <main>
    <h1>Loopwright</h1>
    <p class="hint">Tap a shape to start.</p>
    <div class="all-controls">
      <button type="button" class="all-toggle" data-all-action="off" aria-label="Turn all off">
        <svg
          class="icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 2v8" />
          <path d="M18.36 6.64a9 9 0 1 1-12.73 0" />
        </svg>
      </button>
    </div>
    <div class="character-grid">
      {
        CHARACTERS.map((character) => (
          <button
            type="button"
            class={`character character--${character.category} character--${character.shape}`}
            data-character-id={character.id}
            aria-pressed="false"
            aria-label={character.label}
          >
            <span class="shape" aria-hidden="true" />
          </button>
        ))
      }
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
